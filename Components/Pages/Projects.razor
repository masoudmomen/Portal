@page "/projects"
@layout MainLayout
@rendermode InteractiveServer
@using Portal.Components.PartialComponents

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark">Project Management</h2>
        <p class="text-muted">Manage and monitor all engineering projects</p>
    </div>
    <button class="btn btn-primary btn-lg shadow-sm d-flex align-items-center gap-2" @onclick="OpenCreateModal">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Create New Project
    </button>
</div>

<!-- Search & Filter Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <!-- Search Box -->
            <div class="col-md-6">
                <div class="input-group search-group">
                    <input type="text" class="form-control border-end-0" placeholder="Search by Project ID, Name or Manager...">
                    <button class="btn btn-outline-primary border-start-0 px-3" type="button">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                </div>
            </div>
            
            <!-- Filters -->
            <div class="col-md-6">
                <div class="d-flex gap-2 flex-wrap">
                    <select class="form-select filter-select">
                        <option selected>All Types</option>
                        <option>MEP</option>
                        <option>Civil</option>
                        <option>Electrical</option>
                    </select>
                    <select class="form-select filter-select">
                        <option selected>All Statuses</option>
                        <option>In Progress</option>
                        <option>Completed</option>
                        <option>On Hold</option>
                    </select>
                    <button class="btn btn-light border px-3">
                        <i class="bi bi-funnel"></i> Filters
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Projects Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive" style="min-height:300px;">
        <table class="table table-hover align-middle mb-0" >
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Project ID</th>
                    <th>Project Details</th>
                    <th>Manager / Engineer</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Mock Row 1 -->
                <tr>
                    <td class="ps-4 fw-bold text-primary">#PRJ-2026-001</td>
                    <td>
                        <div class="fw-bold">Pacific Plaza MEP</div>
                        <div class="small text-muted">Downtown, Sector 4</div>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <img src="https://i.pravatar.cc/30?u=1" class="rounded-circle" />
                            <span>John Doe</span>
                        </div>
                    </td>
                    <td>Oct 15, 2026</td>
                    <td><span class="badge bg-soft-success text-success">In Progress</span></td>
                    <td style="width: 150px;">
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: 65%"></div>
                        </div>
                        <span class="small text-muted">65%</span>
                    </td>
                    <td class="text-end pe-4">
                        <div class="dropdown position-relative">
                            <button class="btn btn-light btn-sm border"
                                    type="button"
                                    @onclick="ToggleProjectActionsDropdown">
                                ...
                            </button>

                            @if (isProjectActionsDropdownOpen)
                            {
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm show"
                                    style="display: block; position: absolute; right: 0; top: 100%; z-index: 1050;">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item d-flex align-items-center gap-2"
                                                disabled>
                                            <i class="bi bi-eye"></i>
                                            Details
                                        </button>
                                    </li>

                                    <li>
                                        <button type="button"
                                                class="dropdown-item d-flex align-items-center gap-2"
                                                @onclick="OpenEditModal">
                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </button>
                                    </li>

                                    <li>
                                        <button type="button"
                                                class="dropdown-item text-danger d-flex align-items-center gap-2"
                                                disabled>
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>
                                    </li>
                                </ul>
                            }
                        </div>
                    </td>


                </tr>
                <!-- More rows would go here -->
            </tbody>
        </table>
    </div>
</div>



