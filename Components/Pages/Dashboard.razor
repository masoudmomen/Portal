@page "/"
@page "/dashboard"
@layout MainLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Portal.Components.PartialComponents
<div class="dashboard-page">
    <div class="dashboard-hero mb-4">
        <div class="top-header d-flex justify-content-between align-items-center">
            <div class="text-start">
                <div class="dashboard-kicker">
                    Pacific MEP Engineering
                </div>

                <h2 class="dashboard-title mb-1">
                    Project Management Dashboard
                </h2>

                <p class="dashboard-subtitle mb-0">
                    Monitor projects, tasks, reports and progress in one place.
                </p>
            </div>

            <div class="profile-menu-wrapper ms-3"
                 tabindex="0"
                 @onfocusout="HandleProfileMenuFocusOut">

                <button type="button"
                        class="profile-menu-trigger"
                        @onclick="ToggleProfileMenu"
                        aria-expanded="@isProfileMenuOpen"
                        aria-haspopup="true">

                    <img src="https://i.pravatar.cc/100"
                         alt="User Profile"
                         class="profile-image" />

                    <div class="profile-meta d-none d-md-flex">
                        <span class="profile-name">Portal User</span>
                        <span class="profile-role">Authenticated User</span>
                    </div>

                    <svg class="profile-menu-chevron @(isProfileMenuOpen ? "open" : "")"
                         viewBox="0 0 24 24"
                         width="18"
                         height="18"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path d="M6 9L12 15L18 9"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </button>

                @if (isProfileMenuOpen)
                {
                    <div class="profile-dropdown-panel">
                        <div class="profile-dropdown-header">
                            <img src="https://i.pravatar.cc/100"
                                 alt="User Profile"
                                 class="profile-dropdown-avatar" />
                            <div class="profile-dropdown-userinfo">
                                <div class="profile-dropdown-name">Portal User</div>
                                <div class="profile-dropdown-role">Signed in</div>
                            </div>
                        </div>

                        <div class="profile-dropdown-divider"></div>

                        <button type="button" class="profile-dropdown-item" disabled>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z"
                                      stroke="currentColor" stroke-width="2" />
                                <path d="M4 21C4 17.134 7.13401 14 11 14H13C16.866 14 20 17.134 20 21"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                            <span>Profile</span>
                        </button>

                        <button type="button" class="profile-dropdown-item" disabled>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 15.5C13.933 15.5 15.5 13.933 15.5 12C15.5 10.067 13.933 8.5 12 8.5C10.067 8.5 8.5 10.067 8.5 12C8.5 13.933 10.067 15.5 12 15.5Z"
                                      stroke="currentColor" stroke-width="2" />
                                <path d="M19.4 15A1.65 1.65 0 0 0 19.73 16.82L19.79 16.88A2 2 0 1 1 16.96 19.71L16.9 19.65A1.65 1.65 0 0 0 15.08 19.32A1.65 1.65 0 0 0 14 20.85V21A2 2 0 1 1 10 21V20.91A1.65 1.65 0 0 0 8.91 19.33A1.65 1.65 0 0 0 7.09 19.66L7.04 19.71A2 2 0 1 1 4.21 16.88L4.27 16.82A1.65 1.65 0 0 0 4.6 15A1.65 1.65 0 0 0 3.07 14H3A2 2 0 1 1 3 10H3.09A1.65 1.65 0 0 0 4.61 9A1.65 1.65 0 0 0 4.28 7.18L4.22 7.12A2 2 0 1 1 7.05 4.29L7.11 4.35A1.65 1.65 0 0 0 8.93 4.68H9A1.65 1.65 0 0 0 10 3.15V3A2 2 0 1 1 14 3V3.09A1.65 1.65 0 0 0 15.09 4.67A1.65 1.65 0 0 0 16.91 4.34L16.96 4.29A2 2 0 1 1 19.79 7.12L19.73 7.18A1.65 1.65 0 0 0 19.4 9V9.09A1.65 1.65 0 0 0 20.93 10H21A2 2 0 1 1 21 14H20.91A1.65 1.65 0 0 0 19.39 15Z"
                                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span>Settings</span>
                        </button>

                        <div class="profile-dropdown-divider"></div>

                        <AuthorizeView>
                            <Authorized>
                                <form method="post" action="/auth/logout" class="m-0">
                                    <AntiforgeryToken />
                                    <button type="submit" class="profile-dropdown-item profile-dropdown-item-danger w-100">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M9 21H5C4.44772 21 4 20.5523 4 20V4C4 3.44772 4.44772 3 5 3H9"
                                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                            <path d="M16 17L21 12L16 7"
                                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M21 12H9"
                                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                        </svg>
                                        <span>Sign Out</span>
                                    </button>
                                </form>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>



        </div>
    </div>

    <div class="row g-3 stats-grid">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon-wrapper" style="background-color: #eef2ff; color: #3766ff;">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="3" width="18" height="18" rx="2" stroke="#3766ff" stroke-width="2" />
                        <path d="M3 9H21" stroke="#3766ff" stroke-width="2" />
                        <path d="M8 14H12" stroke="#3766ff" stroke-width="2" />
                    </svg>
                </div>
                <div class="stat-info">
                    <span class="stat-value">12</span>
                    <span class="stat-label">Projects</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon-wrapper" style="background-color: #eef2ff; color: #3766ff;">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 11L11 13L15 9" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M21 12V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2V19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div class="stat-info">
                    <span class="stat-value">36</span>
                    <span class="stat-label">Tasks</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon-wrapper" style="background-color: #eef2ff; color: #3766ff;">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 20V10M12 20V4M6 20V14" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 20H22" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </div>
                <div class="stat-info">
                    <span class="stat-value">7</span>
                    <span class="stat-label">Reports</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon-wrapper" style="background-color: #eef2ff; color: #3766ff;">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div class="stat-info">
                    <span class="stat-value">5</span>
                    <span class="stat-label">Actions</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12 col-lg-7">
            <div class="section-card dashboard-card-glass h-100">
                <div class="section-title d-flex align-items-center justify-content-between">
                    <span>Recent Activities</span>
                    <span class="section-badge">Live</span>
                </div>

                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-dot activity-dot-blue"></div>
                        <div>
                            <div class="activity-title">New report submitted</div>
                            <div class="activity-meta">Today • 10:24 AM</div>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-dot activity-dot-green"></div>
                        <div>
                            <div class="activity-title">Task completed</div>
                            <div class="activity-meta">Today • 09:15 AM</div>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-dot activity-dot-orange"></div>
                        <div>
                            <div class="activity-title">Vision updated</div>
                            <div class="activity-meta">Yesterday • 04:40 PM</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="section-card dashboard-card-accent h-100">
                <div class="section-title">Quick Overview</div>

                <div class="overview-item">
                    <span>Project health</span>
                    <strong>87%</strong>
                </div>

                <div class="overview-progress">
                    <div class="overview-progress-bar" style="width:87%"></div>
                </div>

                <div class="overview-item mt-4">
                    <span>On-time tasks</span>
                    <strong>31 / 38</strong>
                </div>

                <div class="overview-item">
                    <span>Open reports</span>
                    <strong>2</strong>
                </div>

                <div class="overview-item">
                    <span>Pending actions</span>
                    <strong>4</strong>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    private bool isProfileMenuOpen;

    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
    }

    private async Task HandleProfileMenuFocusOut(FocusEventArgs _)
    {
        await Task.Delay(120);
        isProfileMenuOpen = false;
    }
}
