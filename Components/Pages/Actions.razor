    // ---------- Form state ----------
    private bool isTaskModalOpen;
    private bool isTaskEditMode;
    private bool isSubtaskModalOpen;
    private bool isSubtaskEditMode;
    private int editingTaskId;      // real DB Id of the task being edited
    private int taskModalActionId;  // parent Action Id for new tasks
    private int subtaskModalTaskId; // parent Task Id for new subtasks
    private int editingSubtaskId;   // real DB Id of the subtask being edited

    private class TaskFormModel
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string AssignedTo { get; set; } = string.Empty;
        public EnumsClass.TaskStatus Status { get; set; } = EnumsClass.TaskStatus.New;
        public EnumsClass.ActionPriority Priority { get; set; } = EnumsClass.ActionPriority.Medium;
        public DateTime? DueDate { get; set; }
        public int Progress { get; set; }
    }

    private class SubtaskFormModel
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    private TaskFormModel taskForm = new();
    private SubtaskFormModel subtaskForm = new();

    // ---------- Task modal ----------
    private void OpenCreateTaskModal()
    {
        if (CurrentVisibleAction == null) return;

        taskModalActionId = CurrentVisibleAction.Id;
        isTaskEditMode = false;
        taskForm = new TaskFormModel
        {
            AssignedTo = CurrentVisibleAction.AssignedTo,
            Priority = CurrentVisibleAction.Priority,
            DueDate = CurrentVisibleAction.DueDate
        };
        isTaskModalOpen = true;
    }

    private void OpenEditTaskModal(TaskItemModel task)
    {
        editingTaskId = task.Id;
        isTaskEditMode = true;
        taskForm = new TaskFormModel
        {
            Title = task.Title,
            Description = task.Description,
            AssignedTo = task.AssignedTo,
            Status = task.Status,
            Progress = task.Progress,
            Priority = task.Priority,
            DueDate = task.DueDate
        };
        isTaskModalOpen = true;
    }

    private void CloseTaskModal() => isTaskModalOpen = false;

    private async Task SaveTask()
    {
        if (string.IsNullOrWhiteSpace(taskForm.Title)) return;

        if (isTaskEditMode)
        {
            var task = CurrentVisibleAction?.Tasks.FirstOrDefault(t => t.Id == editingTaskId);
            if (task != null)
            {
                // Persist to DB first
                await ActionService.UpdateTaskAsync(new TaskItemModel
                {
                    Id = task.Id,
                    Title = taskForm.Title,
                    Description = taskForm.Description,
                    AssignedTo = taskForm.AssignedTo,
                    Status = taskForm.Status,
                    Priority = taskForm.Priority,
                    Progress = (taskForm.Status == EnumsClass.TaskStatus.Completed && !task.Subtasks.Any())? 100 : 0,
                    DueDate = taskForm.DueDate
                });

                // Then update UI state
                task.Title = taskForm.Title;
                task.Description = taskForm.Description;
                task.AssignedTo = taskForm.AssignedTo;
                task.Status = taskForm.Status;
                task.Progress = (taskForm.Status == EnumsClass.TaskStatus.Completed && !task.Subtasks.Any()) ? 100 : 0;
                task.Priority = taskForm.Priority;
                task.DueDate = taskForm.DueDate;
            }
        }
        else
        {
            var newTask = new TaskItemModel
            {
                Title = taskForm.Title.Trim(),
                Description = taskForm.Description,
                AssignedTo = taskForm.AssignedTo,
                Status = taskForm.Status,
                Priority = taskForm.Priority,
                DueDate = taskForm.DueDate,
                Progress = (taskForm.Status == EnumsClass.TaskStatus.Completed)? 100 : 0,
                Subtasks = new List<SubTaskItemModel>()
            };

            var created = await ActionService.CreateTaskAsync(taskModalActionId, newTask);
            if (created != null && CurrentVisibleAction != null)
            {
                CurrentVisibleAction.Tasks.Add(created);
                expandedTaskIds.Add(created.Id);
            }
        }

        UpdateActionProgress(CurrentVisibleAction!);
        CloseTaskModal();
    }

    // ---------- Subtask modal ----------
    private void OpenSubtaskModal(SubTaskItemModel? subtask, int parentTaskId)
    {
        subtaskModalTaskId = parentTaskId;
        isSubtaskEditMode = subtask != null;
        editingSubtaskId = subtask?.Id ?? 0;
        subtaskForm = new SubtaskFormModel
        {
            Title = subtask?.Title ?? string.Empty,
            Description = subtask?.Description ?? string.Empty
        };
        isSubtaskModalOpen = true;
    }

    private void CloseSubtaskModal() => isSubtaskModalOpen = false;

    private async Task SaveSubtask()
    {
        if (string.IsNullOrWhiteSpace(subtaskForm.Title)) return;

        var parentTask = CurrentVisibleAction?.Tasks.FirstOrDefault(t => t.Id == subtaskModalTaskId);
        if (parentTask == null) return;

        if (isSubtaskEditMode)
        {
            var subtask = parentTask.Subtasks.FirstOrDefault(s => s.Id == editingSubtaskId);
            if (subtask != null)
            {
                subtask.Title = subtaskForm.Title.Trim();
                subtask.Description = subtaskForm.Description;
                await ActionService.UpdateSubtaskAsync(subtask.Id, subtask.Title, subtaskForm.Description);
            }
        }
        else
        {
            var created = await ActionService.CreateSubtaskAsync(subtaskModalTaskId, subtaskForm.Title.Trim(), subtaskForm.Description);
            if (created != null)
            {
                parentTask.Subtasks.Add(created);
                RecalculateTaskProgressInMemory(parentTask);
            }
        }

        UpdateTaskProgress(parentTask);
        UpdateActionProgress(CurrentVisibleAction!);
        CloseSubtaskModal();
    }

}
