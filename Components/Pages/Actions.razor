    private async Task ToggleSubtask(TaskItemModel task, SubTaskItemModel subtask)
    {
        var success = await ActionService.ToggleSubtaskAsync(subtask.Id, !subtask.IsDone);
        if (success)
        {
            subtask.IsDone = !subtask.IsDone;
            RecalculateTaskProgressInMemory(task);
            UpdateTaskProgress(task);
            UpdateActionProgress(CurrentVisibleAction!);

        }
    }

    private void UpdateTaskProgress(TaskItemModel task)
    {
        if (!task.Subtasks.Any())
            return;

        var doneCount = task.Subtasks.Count(st => st.IsDone);
        task.Progress = (int)Math.Round((double)doneCount / task.Subtasks.Count * 100);

        if (task.Progress == 100)
            task.Status = EnumsClass.TaskStatus.Completed;
        else if (task.Progress > 0)
            task.Status = EnumsClass.TaskStatus.InProgress;
        else
            task.Status = EnumsClass.TaskStatus.New;

        ActionService.UpdateTaskAsync(task);
        // if (selectedAction != null)
        // {
        //     UpdateActionProgress(selectedAction);
        // }
    }

    private void UpdateActionProgress(ActionItemModel action)
    {
        if (!action.Tasks.Any()) return;
        var avgProgress = action.Tasks.Average(t => t.Progress);
        action.Progress = (int)Math.Round(avgProgress);

        if (action.Progress == 100)
            action.Status = EnumsClass.ActionStatus.Completed;
        else if (action.Progress < 100)
            action.Status = EnumsClass.ActionStatus.InProgress;

        ActionService.UpdateActionAsync(new ActionFormModel
        {
            Id = action.Id,
            Title= action.Title,
            Description = action.Description,
            AssignedBy = action.AssignedBy,
            AssignedTo= action.AssignedTo,
            DueDateText = action.DueDate,
            Priority = action.Priority,
            ProjectId = action.ProjectId,
            ProjectName = action.ProjectName,
            Status = action.Status,
        });
    }

    private bool IsOverdue(ActionItemModel action)
    {
        return action.DueDate.HasValue &&
               action.DueDate.Value.Date < DateTime.Today &&
               action.Status != EnumsClass.ActionStatus.Completed &&
               action.Status != EnumsClass.ActionStatus.Canceled;
    }

    private string GetStatusBadgeClass(EnumsClass.ActionStatus status) => status switch
    {
        EnumsClass.ActionStatus.New => "bg-secondary-subtle text-secondary",
        EnumsClass.ActionStatus.Assigned => "bg-info-subtle text-info",
        EnumsClass.ActionStatus.InProgress => "bg-primary-subtle text-primary",
        EnumsClass.ActionStatus.Blocked => "bg-danger-subtle text-danger",
        EnumsClass.ActionStatus.Completed => "bg-success-subtle text-success",
        EnumsClass.ActionStatus.Canceled => "bg-dark-subtle text-dark",
        _ => "bg-light text-dark"
    };

    private string GetTaskStatusBadgeClass(EnumsClass.TaskStatus status) => status switch
    {
        EnumsClass.TaskStatus.New => "bg-secondary-subtle text-secondary",
        EnumsClass.TaskStatus.InProgress => "bg-primary-subtle text-primary",
        EnumsClass.TaskStatus.Blocked => "bg-danger-subtle text-danger",
        EnumsClass.TaskStatus.Completed => "bg-success-subtle text-success",
        _ => "bg-light text-dark"
    };

    private string GetPriorityBadgeClass(EnumsClass.ActionPriority priority) => priority switch
    {
        EnumsClass.ActionPriority.Low => "bg-light text-muted border",
        EnumsClass.ActionPriority.Medium => "bg-info-subtle text-info",
        EnumsClass.ActionPriority.High => "bg-warning-subtle text-warning",
        EnumsClass.ActionPriority.Critical => "bg-danger text-white",
        _ => "bg-light text-muted"
    };

    private string GetProgressBarClass(int progress) => progress switch
    {
        >= 100 => "bg-success",
        >= 50 => "bg-primary",
        >= 20 => "bg-warning",
        _ => "bg-danger"
    };


    // تضمین می‌کند اکشن انتخاب‌شده حتماً در لیست فیلترشده فعلی وجود داشته باشد
    private ActionItemModel? CurrentVisibleAction
    {
        get
        {
            if (selectedAction == null)
                return null;

            // اگر اکشن در لیست فیلترشده باشد، همان را برمی‌گرداند؛ در غیر این صورت null
            return FilteredActions.FirstOrDefault(a => a.Id == selectedAction.Id);
        }
    }


    private void RecalculateTaskProgressInMemory(TaskItemModel task)
    {
        if (task.Subtasks.Any())
        {
            var completed = task.Subtasks.Count(s => s.IsDone);
            task.Progress = (int)Math.Round((double)completed / task.Subtasks.Count * 100);

            if (task.Progress == 100)
                task.Status = EnumsClass.TaskStatus.Completed;
            // else if (task.Progress > 0 && task.Status == EnumsClass.TaskStatus.New)
            //     task.Status = EnumsClass.TaskStatus.InProgress;
            else if (task.Progress < 100)
                task.Status = EnumsClass.TaskStatus.InProgress;
        }
        else
        {
            task.Progress = 0;
            task.Status = EnumsClass.TaskStatus.New;
        }
    }

    private void CalculateActionProgressInMemory(ActionItemModel action)
    {
        if (!action.Tasks.Any()) return;
        var avgProgress = action.Tasks.Average(t => t.Progress);
        action.Progress = (int)Math.Round(avgProgress);

        if (action.Progress == 100)
            action.Status = EnumsClass.ActionStatus.Completed;
        else if (action.Progress < 100)
            action.Status = EnumsClass.ActionStatus.InProgress;
    }

