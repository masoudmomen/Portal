@inherits LayoutComponentBase
@using MudBlazor


<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- SIDEBAR -->
    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="1"
               Variant="DrawerVariant.Responsive"
               Class="pa-2">

        <MudText Typo="Typo.h6" Class="pa-3">
            🚀 Portal
        </MudText>

        <MudNavMenu Dense="true">

            <MudNavLink Href="/" Match="NavLinkMatch.All">
                Dashboard
            </MudNavLink>

            <MudNavLink Href="/visions">
                Visions
            </MudNavLink>

            <MudNavLink Href="/projects">
                Projects
            </MudNavLink>

            <MudNavLink Href="/tasks">
                Tasks
            </MudNavLink>

            <MudNavLink Href="/reports">
                Reports
            </MudNavLink>

            <MudDivider Class="my-2" />

            <MudNavLink Href="/users">
                Users & Roles
            </MudNavLink>

        </MudNavMenu>

    </MudDrawer>

    <!-- MAIN -->
    <MudMainContent>

        <!-- TOP BAR -->
        <MudAppBar Elevation="1" Dense="true">

            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           OnClick="ToggleDrawer" />

            <MudText Typo="Typo.h6">
                Company Control Center
            </MudText>

            <MudSpacer />

            <MudIconButton Icon="@Icons.Material.Filled.DarkMode" />

            <MudAvatar Color="Color.Primary">
                A
            </MudAvatar>

        </MudAppBar>

        <!-- PAGE CONTENT -->
        <div class="pa-4">

            @Body

        </div>

    </MudMainContent>

</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}